{
  "Aggregator": {
    "Kafka": {
      "BootstrapServers": "localhost:9094",
      "ApplicationId": "changemonitor-data-aggregator",
      "InputCdcTopics": [
        "changelog.all"
      ],
      "MetadataTopic": "app.transaction_meta",
      "OutputTopic": "aggregates.by_tx",
      "RepartitionTopic": "agg.changes.by_tx",
      "DlqTopic": "aggregator.dlq",
      "EnableAutoTopicCreation": false,
      "DefaultNumPartitions": 1
    },
    "Processing": {
      "FlushIntervalMs": 800,
      "HardTtlMs": 2000,
      "MaxEventsPerBucket": 1000,
      "RejectWithoutTxId": true,
      "EmitPartialOnLimit": true
    },
    "Http": {
      "Port": 8080
    }
  },
  "Finalizer": {
    "Kafka": {
      "BootstrapServers": "localhost:9094",
      "InputTopic": "aggregates.by_tx",
      "GroupId": "changemonitor-finalizer",
      "EnableAutoCreateTopics": false
    },
    "ClickHouse": {
      "ConnectionString": "Host=localhost;Port=8123;Database=default;User=default;Password=123456",
      "TableName": "audit_log",
      "EnsureSchema": true
    },
    "Http": {
      "Port": 8081
    },
    "Policy": {
      "ConfigPath": "changelog-config.yaml"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.Hosting": "Debug",
      "Microsoft.AspNetCore.Server.Kestrel": "Debug"
    }
  },
  "AllowedHosts": "*"
}
