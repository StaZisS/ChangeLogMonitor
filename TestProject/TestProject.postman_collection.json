{
	"info": {
		"_postman_id": "changelog-test-harness",
		"name": "ChangeLogMonitor TestHarness",
		"description": "API для тестирования ChangeLogMonitor: аудит изменений полей, коллекций и связей между таблицами",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "demoUserId",
			"value": "fe3eab31-1fc4-4c1f-b1f0-60bc78cb2a86",
			"type": "string"
		},
		{
			"key": "testUserId",
			"value": "a1b2c3d4-5e6f-7a8b-9c0d-e1f2a3b4c5d6",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Generate Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"demo-user\",\n    \"password\": \"demo-pass\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/token",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "token"]
						},
						"description": "Получить JWT токен для demo-user. Токен автоматически сохраняется в переменную коллекции."
					},
					"response": []
				},
				{
					"name": "Generate Token (Test User)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"test-user\",\n    \"password\": \"test-pass\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/token",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "token"]
						},
						"description": "Получить JWT токен для test-user. Используй этого пользователя для тестирования reassign."
					},
					"response": []
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Create Order",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"description\": \"Test Order\",\n    \"amount\": 150.50\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": ["{{baseUrl}}"],
							"path": ["orders"]
						},
						"description": "Создать новый заказ. Тестирует onCreate: allFields."
					},
					"response": []
				},
				{
					"name": "Update Order",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"description\": \"Updated Order Description\",\n    \"amount\": 200.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/:orderId",
							"host": ["{{baseUrl}}"],
							"path": ["orders", ":orderId"],
							"variable": [
								{
									"key": "orderId",
									"value": "ORDER_ID_HERE",
									"description": "GUID заказа"
								}
							]
						},
						"description": "Обновить заказ. Тестирует onUpdate: delta - логируются только изменённые поля."
					},
					"response": []
				},
				{
					"name": "Reassign Order (Reference Change)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"newUserId\": \"{{testUserId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/:orderId/reassign",
							"host": ["{{baseUrl}}"],
							"path": ["orders", ":orderId", "reassign"],
							"variable": [
								{
									"key": "orderId",
									"value": "ORDER_ID_HERE",
									"description": "GUID заказа"
								}
							]
						},
						"description": "Переназначить заказ другому пользователю. Тестирует изменение REFERENCE (связи Order -> User)."
					},
					"response": []
				}
			]
		},
		{
			"name": "Tags",
			"item": [
				{
					"name": "Get All Tags",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/tags",
							"host": ["{{baseUrl}}"],
							"path": ["tags"]
						},
						"description": "Получить список всех тегов."
					},
					"response": []
				},
				{
					"name": "Create Tag",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Urgent\",\n    \"color\": \"#FF0000\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/tags",
							"host": ["{{baseUrl}}"],
							"path": ["tags"]
						},
						"description": "Создать новый тег."
					},
					"response": []
				},
				{
					"name": "Update Tag",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Very Urgent\",\n    \"color\": \"#CC0000\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/tags/:tagId",
							"host": ["{{baseUrl}}"],
							"path": ["tags", ":tagId"],
							"variable": [
								{
									"key": "tagId",
									"value": "TAG_ID_HERE",
									"description": "GUID тега"
								}
							]
						},
						"description": "Обновить тег."
					},
					"response": []
				},
				{
					"name": "Delete Tag",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/tags/:tagId",
							"host": ["{{baseUrl}}"],
							"path": ["tags", ":tagId"],
							"variable": [
								{
									"key": "tagId",
									"value": "TAG_ID_HERE",
									"description": "GUID тега"
								}
							]
						},
						"description": "Удалить тег. Тестирует onDelete и каскадное удаление из OrderTags."
					},
					"response": []
				}
			]
		},
		{
			"name": "Order Tags (Collections)",
			"item": [
				{
					"name": "Get Order Tags",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/orders/:orderId/tags",
							"host": ["{{baseUrl}}"],
							"path": ["orders", ":orderId", "tags"],
							"variable": [
								{
									"key": "orderId",
									"value": "ORDER_ID_HERE",
									"description": "GUID заказа"
								}
							]
						},
						"description": "Получить все теги заказа."
					},
					"response": []
				},
				{
					"name": "Add Tag to Order (Collection Add)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"tagId\": \"TAG_ID_HERE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/:orderId/tags",
							"host": ["{{baseUrl}}"],
							"path": ["orders", ":orderId", "tags"],
							"variable": [
								{
									"key": "orderId",
									"value": "ORDER_ID_HERE",
									"description": "GUID заказа"
								}
							]
						},
						"description": "Добавить тег к заказу. Тестирует COLLECTION ADD - добавление элемента в many-to-many связь через OrderTag."
					},
					"response": []
				},
				{
					"name": "Remove Tag from Order (Collection Remove)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/orders/:orderId/tags/:tagId",
							"host": ["{{baseUrl}}"],
							"path": ["orders", ":orderId", "tags", ":tagId"],
							"variable": [
								{
									"key": "orderId",
									"value": "ORDER_ID_HERE",
									"description": "GUID заказа"
								},
								{
									"key": "tagId",
									"value": "TAG_ID_HERE",
									"description": "GUID тега"
								}
							]
						},
						"description": "Удалить тег из заказа. Тестирует COLLECTION REMOVE - удаление элемента из many-to-many связи."
					},
					"response": []
				}
			]
		},
		{
			"name": "Bulk Operations",
			"description": "Операции массового обновления и raw SQL запросы с аудитом. Работают только с PostgreSQL.",
			"item": [
				{
					"name": "Batch Update Status (ExecuteUpdate)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fromStatus\": 0,\n    \"toStatus\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/batch/update-status",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "batch", "update-status"]
						},
						"description": "Массовое обновление статуса заказов через EF Core ExecuteUpdate.\n\nStatus values:\n- 0: New\n- 1: Processing\n- 2: Confirmed\n- 3: Shipped\n- 4: Delivered\n- 5: Cancelled\n\nТестирует IRawAuditService.RecordRawOperationAsync() с BulkInfo."
					},
					"response": []
				},
				{
					"name": "Batch Delete by Status (ExecuteDelete)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/batch/delete-by-status",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "batch", "delete-by-status"]
						},
						"description": "Массовое удаление заказов по статусу через EF Core ExecuteDelete.\n\nСначала удаляет связанные OrderTags (с отдельной записью аудита), затем сами заказы.\n\nТестирует несколько записей аудита в одной транзакции."
					},
					"response": []
				},
				{
					"name": "Raw Update by Amount (Extension Method)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"minAmount\": 100.00,\n    \"maxAmount\": 500.00,\n    \"newStatus\": 2,\n    \"reason\": \"Bulk confirmation for medium orders\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/raw/update-by-amount",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "raw", "update-by-amount"]
						},
						"description": "Raw SQL обновление заказов по диапазону суммы.\n\nИспользует extension метод ExecuteSqlRawWithAuditAsync() для автоматической записи аудита.\n\nТестирует wrapper-методы для raw SQL."
					},
					"response": []
				},
				{
					"name": "Cancel Old Orders (AuditScope)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/orders/raw/cancel-old?olderThanDays=30",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "raw", "cancel-old"],
							"query": [
								{
									"key": "olderThanDays",
									"value": "30",
									"description": "Отменить заказы старше N дней"
								}
							]
						},
						"description": "Отмена старых заказов через raw SQL с использованием AuditScope.\n\nДемонстрирует ambient context:\n- AuditScope.Begin() устанавливает контекст\n- RecordRawOperationFromScopeAsync() использует данные из scope\n\nТестирует вложенные hints и reason из AuditScope."
					},
					"response": []
				}
			]
		},
		{
			"name": "Debug",
			"item": [
				{
					"name": "Get Audit Logs (Raw Payload)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/debug/audit-logs?limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["debug", "audit-logs"],
							"query": [
								{
									"key": "limit",
									"value": "10",
									"description": "Количество записей (1-100)"
								}
							]
						},
						"description": "Получить последние записи аудита с распарсенным protobuf payload.\n\nРаботает только с PostgreSQL.\n\nПоказывает:\n- actor (userId, userName)\n- request context (requestId, serviceName, clientIp)\n- bulk info (isBulk, affectedCount, target)\n- hints\n- enumSnapshots\n- referenceSnapshots\n- collectionDeltas"
					},
					"response": []
				}
			]
		}
	]
}
